# ============================================================
# 复制本文件为 .env 并填入真实 key（.env 已被 .gitignore 排除）
# ============================================================

# ===== LLM 提供商: qwen | glm =====
LLM_PROVIDER=qwen

# ---- 阿里云百炼 DashScope（通义千问，OpenAI 兼容）----
# 公共域名（跨业务空间 key 可用）：
QWEN_API_KEY=sk-填入你的千问key
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 若你的 key 属于业务空间专属实例（ws-xxx.maas.aliyuncs.com），改用：
#   QWEN_BASE_URL=https://{你的WorkspaceId}.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
#   模型名也要换成工作空间里实际部署的（如 qwen3.7-text-embedding-flash）
# 对话模型可选: qwen-plus / qwen-turbo / qwen-flash / qwen-max
QWEN_CHAT_MODEL=qwen-plus
# 向量模型 text-embedding-v3 默认输出 1024 维
QWEN_EMBED_MODEL=text-embedding-v3
QWEN_EMBED_DIM=1024

# ---- 智谱 GLM（OpenAI 兼容）----
GLM_API_KEY=填入你的智谱key
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
# 对话模型可选: glm-4-flash(免费) / glm-4-air / glm-4-plus / glm-4.5
GLM_CHAT_MODEL=glm-4-flash
# embedding-3 支持自定义维度 256/512/1024/2048，这里与千问对齐为 1024
GLM_EMBED_MODEL=embedding-3
GLM_EMBED_DIM=1024

# ===== RAG 参数 =====
# 切块目标长度（中文字符数）与相邻块重叠
CHUNK_SIZE=400
CHUNK_OVERLAP=50
# 检索返回条数
TOP_K=5
# 最高相似度低于该阈值时拒答（0~1，cosine 空间，请拿真实问题实验调整）
SIM_THRESHOLD=0.3
# ===== v0.2 混合检索 =====
RECALL_N=10
RERANK_MODEL=qwen3.7-text-rerank
RERANK_CANDIDATES=8
DB_DIR=db/chroma
DATA_DIR=data
COLLECTION_NAME=docs
